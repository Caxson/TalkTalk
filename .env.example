# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Server ---
TALKTALK_HTTP_ADDR=:8080
# debug | info | warn | error
TALKTALK_LOG_LEVEL=info
# text | json
TALKTALK_LOG_FORMAT=text
TALKTALK_SHUTDOWN_TIMEOUT=10s

# --- LLM (any OpenAI-compatible endpoint; default DeepSeek) ---
TALKTALK_LLM_API_KEY=
# TALKTALK_LLM_BASE_URL=https://api.deepseek.com
# TALKTALK_LLM_MODEL=deepseek-flash
# JSON merged into every request. For DeepSeek, thinking is disabled by
# default because it delays the first spoken word by seconds.
# TALKTALK_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
# Volcengine Ark example:
# TALKTALK_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# TALKTALK_LLM_MODEL=doubao-seed-2-0-mini-260215

# --- Speech: Alibaba Cloud Model Studio (DashScope) ---
DASHSCOPE_API_KEY=
# TALKTALK_ASR_MODEL=paraformer-realtime-v2
# Silence (ms) that ends your turn, 200-6000.
# TALKTALK_ASR_SILENCE_MS=500
# TALKTALK_TTS_MODEL=cosyvoice-v3-flash
# Voice must match the model family (v3 models need *_v3 voices).
# TALKTALK_TTS_VOICE=longxiaochun_v3
# 8000 | 16000 | 24000 | 48000
# TALKTALK_TTS_SAMPLE_RATE=24000

# --- Conversation ---
# TALKTALK_SYSTEM_PROMPT=
# Substantive characters you must say over the assistant to interrupt it.
# TALKTALK_INTERRUPT_MIN_RUNES=2
# TALKTALK_MAX_SESSIONS=4
# Comma-separated STUN/TURN URLs; leave empty for localhost / LAN.
# TALKTALK_ICE_SERVERS=

# --- Avatar (optional; run `make assets` first, needs `brew install onnxruntime`) ---
# Leave empty for voice only.
# TALKTALK_LIPSYNC_MODEL=assets/models/wav2arkit_cpu.onnx
# TALKTALK_ONNXRUNTIME_LIB=/opt/homebrew/opt/onnxruntime/lib/libonnxruntime.dylib
# Mouth/jaw amplitude multiplier (the model opens the mouth little for Chinese).
# TALKTALK_MOUTH_GAIN=1.6
# TALKTALK_ASSETS_DIR=assets
# Default character: mio | hiyori (empty: the first available).
# TALKTALK_CHARACTER=
# Replace the built-in cast with your own JSON roster (see README, "Cast").
# TALKTALK_CAST_FILE=
