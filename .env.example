# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Server ---
TALKTALK_HTTP_ADDR=:8080
# debug | info | warn | error
TALKTALK_LOG_LEVEL=info
# text | json
TALKTALK_LOG_FORMAT=text
TALKTALK_SHUTDOWN_TIMEOUT=10s

# --- Model providers (wired up in M1; unused for now) ---
# Volcengine (Doubao streaming ASR / TTS / LLM)
# VOLC_APP_ID=
# VOLC_ACCESS_TOKEN=
# VOLC_ARK_API_KEY=
# Alibaba Cloud DashScope (CosyVoice TTS, Qwen)
# DASHSCOPE_API_KEY=
# DeepSeek
# DEEPSEEK_API_KEY=
